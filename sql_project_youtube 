CREATE DATABASE yt_analytics_dw;

USE yt_analytics_dw;

-- =====================================================
-- YOUTUBE ANALYTICS DATA WAREHOUSE PROJECT
-- BASIC TO ADVANCED SQL PROJECT
-- =====================================================

-- =====================================================
-- 1. CATEGORY TABLE
-- =====================================================

CREATE TABLE dim_categories (
    category_id INT,
    category_name VARCHAR(255)
);

-- =====================================================
-- 2. CHANNEL TABLE
-- =====================================================

CREATE TABLE dim_channels (
    channel_id VARCHAR(50),
    channel_title VARCHAR(255)
);

-- =====================================================
-- 3. VIDEO TABLE
-- =====================================================

CREATE TABLE dim_videos (
    video_id VARCHAR(50),
    title TEXT,
    publish_time VARCHAR(50),
    description LONGTEXT,
    tags LONGTEXT,
    category_id INT,
    channel_id VARCHAR(50)
);

-- =====================================================
-- 4. TRENDING FACT TABLE
-- =====================================================

CREATE TABLE fact_trending_stats (
    stat_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    video_id VARCHAR(50),
    trending_date VARCHAR(20),
    views BIGINT,
    likes BIGINT,
    dislikes BIGINT,
    comments BIGINT
);

-- =====================================================
-- PHASE 1 — DATA CLEANING & SQL FOUNDATION
-- =====================================================

-- Q1 Detect NULL Values

SELECT
    SUM(CASE WHEN title IS NULL THEN 1 ELSE 0 END) AS null_titles,
    SUM(CASE WHEN video_id IS NULL THEN 1 ELSE 0 END) AS null_video_ids
FROM dim_videos;

-- Q2 Replace NULL Values Using IFNULL

SELECT
    video_id,
    IFNULL(comments,0) AS comments
FROM fact_trending_stats;

-- Q3 Detect Duplicate Videos

SELECT
    video_id,
    COUNT(*) AS duplicate_count
FROM dim_videos
GROUP BY video_id
HAVING COUNT(*) > 1;

-- Q4 Remove Duplicate Records Using ROW_NUMBER

WITH duplicate_cte AS (

    SELECT *,
           ROW_NUMBER() OVER(
               PARTITION BY video_id
               ORDER BY video_id
           ) AS rn

    FROM dim_videos
)

SELECT *
FROM duplicate_cte
WHERE rn > 1;

-- Q5 Standardize Channel Names

SET SQL_SAFE_UPDATES = 0;

UPDATE dim_channels
SET channel_title = TRIM(UPPER(channel_title));

-- Q6 Convert Publish Time into DATETIME

SELECT
    STR_TO_DATE(
        publish_time,
        '%Y-%m-%dT%H:%i:%sZ'
    ) AS publish_datetime
FROM dim_videos;

-- Q7 Detect Invalid Metrics

SELECT *
FROM fact_trending_stats
WHERE views < 0
OR likes < 0
OR comments < 0;

-- Q8 Create Analytics VIEW

CREATE VIEW vw_clean_youtube_data AS

SELECT
    v.video_id,
    v.title,
    c.channel_title,
    cat.category_name,
    f.views,
    f.likes,
    f.comments,
    f.trending_date

FROM fact_trending_stats f
JOIN dim_videos v
ON f.video_id = v.video_id
JOIN dim_channels c
ON v.channel_id = c.channel_id
JOIN dim_categories cat
ON v.category_id = cat.category_id;

SELECT * FROM yt_analytics_dw.vw_clean_youtube_data;


-- Q9 Detect Orphan Records

SELECT 
	f.video_id
FROM fact_trending_stats f
LEFT JOIN dim_videos v
ON f.video_id = v.video_id
WHERE v.video_id IS NULL;


-- Q10 Video Performance Classification

SELECT
    title,
    views,

    CASE
        WHEN views > 5000000 THEN 'Viral'
        WHEN views > 1000000 THEN 'Trending'
        ELSE 'Normal'
    END AS performance_type

FROM vw_clean_youtube_data;

-- =====================================================
-- PHASE 2 — BUSINESS ANALYTICS & KPI REPORTING
-- =====================================================

-- Q11 Top 10 Most Viewed Videos

SELECT
    title,
    SUM(views) AS total_views
FROM vw_clean_youtube_data
GROUP BY title
ORDER BY total_views DESC
LIMIT 10;

-- Q12 Top Channels by Total Views

SELECT
    channel_title,
    SUM(views) AS total_views
FROM vw_clean_youtube_data
GROUP BY channel_title
ORDER BY total_views DESC;

-- Q13 Category Wise Market Share

SELECT
    category_name,

    ROUND(
        SUM(views) * 100 /
        SUM(SUM(views)) OVER(),
        2
    ) AS market_share_percent

FROM vw_clean_youtube_data
GROUP BY category_name;

-- Q14 KPI Dashboard Metrics

SELECT
    COUNT(DISTINCT video_id) AS total_videos,
    SUM(views) AS total_views,
    SUM(likes) AS total_likes,
    SUM(comments) AS total_comments
FROM vw_clean_youtube_data;

-- Q15 Engagement Rate Analysis

SELECT
    title,

    ROUND(
        ((likes + comments) * 100.0 / views),
        2
    ) AS engagement_rate

FROM vw_clean_youtube_data;

-- Q16 Monthly Trending Analysis

SELECT
    YEAR(STR_TO_DATE(trending_date,'%y.%d.%m')) AS year_no,

    MONTH(
        STR_TO_DATE(trending_date,'%y.%d.%m')
    ) AS month_no,

    COUNT(*) AS total_trending_videos

FROM vw_clean_youtube_data

GROUP BY
YEAR(STR_TO_DATE(trending_date,'%y.%d.%m')),
MONTH(STR_TO_DATE(trending_date,'%y.%d.%m'));

-- Q17 Revenue Estimation Analysis

SELECT
    title,
    views,

    ROUND(
        (views/1000)*3,
        2
    ) AS estimated_revenue

FROM vw_clean_youtube_data;

-- Q18 High Performing Categories Using Subquery

SELECT
    category_name,
    AVG(views) AS avg_views

FROM vw_clean_youtube_data

GROUP BY category_name

HAVING AVG(views) >
(
    SELECT AVG(views)
    FROM vw_clean_youtube_data
);

-- Q19 Top Engagement Channels

SELECT
    channel_title,
    SUM(likes + comments) AS total_engagement

FROM vw_clean_youtube_data

GROUP BY channel_title
ORDER BY total_engagement DESC;

-- Q20 Executive Monthly Trend Report

SELECT
    MONTH(
        STR_TO_DATE(trending_date,'%y.%d.%m')
    ) AS month_no,

    SUM(views) AS total_views

FROM vw_clean_youtube_data

GROUP BY MONTH(
    STR_TO_DATE(trending_date,'%y.%d.%m')
);

-- =====================================================
-- PHASE 3 — ADVANCED SQL ANALYTICS ENGINEERING
-- =====================================================

-- Q21 Rank Videos Using DENSE_RANK

SELECT
    title,
    views,

    DENSE_RANK()
    OVER(
        ORDER BY views DESC
    ) AS ranking

FROM vw_clean_youtube_data;

-- Q22 Running Total of Views

SELECT
    trending_date,

    SUM(views) AS daily_views,

    SUM(SUM(views))
    OVER(
        ORDER BY trending_date
    ) AS running_total

FROM vw_clean_youtube_data

GROUP BY trending_date;

-- Q23 Moving Average Analytics

SELECT
    trending_date,

    AVG(views)
    OVER(
        ORDER BY trending_date
        ROWS BETWEEN 6 PRECEDING
        AND CURRENT ROW
    ) AS moving_avg

FROM vw_clean_youtube_data;

-- Q24 Compare Previous Day Views Using LAG

SELECT
    trending_date,

    SUM(views) AS current_views,

    LAG(SUM(views))
    OVER(
        ORDER BY trending_date
    ) AS previous_views

FROM vw_clean_youtube_data

GROUP BY trending_date;

-- Q25 Forecast Next Day Views Using LEAD

SELECT
    trending_date,

    SUM(views) AS current_views,

    LEAD(SUM(views))
    OVER(
        ORDER BY trending_date
    ) AS next_day_views

FROM vw_clean_youtube_data

GROUP BY trending_date;

-- Q26 Segment Videos Using NTILE

SELECT
    title,
    views,

    NTILE(4)
    OVER(
        ORDER BY views DESC
    ) AS performance_quartile

FROM vw_clean_youtube_data;

-- Q27 FIRST_VALUE and LAST_VALUE Analysis

SELECT
    title,
    trending_date,
    views,

    FIRST_VALUE(views)
    OVER(
        PARTITION BY title
        ORDER BY trending_date
    ) AS first_views,

    LAST_VALUE(views)
    OVER(
        PARTITION BY title
        ORDER BY trending_date
        ROWS BETWEEN UNBOUNDED PRECEDING
        AND UNBOUNDED FOLLOWING
    ) AS latest_views

FROM vw_clean_youtube_data;

-- Q28 Recursive CTE Date Generator

WITH RECURSIVE dates AS (

    SELECT DATE('2025-01-01') AS dt

    UNION ALL

    SELECT DATE_ADD(dt, INTERVAL 1 DAY)
    FROM dates
    WHERE dt < '2025-01-10'
)

SELECT *
FROM dates;

