-- Q31 Detect Viral Videos

SELECT
    title,
    views,
    likes,
    comments

FROM vw_clean_youtube_data

WHERE views > 5000000
AND likes > 200000;

-- Q32 Correlated Subquery Analysis

SELECT
    title,
    views

FROM vw_clean_youtube_data v1

WHERE views >
(
    SELECT AVG(views)
    FROM vw_clean_youtube_data v2
    WHERE v1.category_name = v2.category_name
);

-- Q33 Trend Drop Detection

WITH trend_cte AS (

    SELECT
        title,
        trending_date,
        views,

        LAG(views)
        OVER(
            PARTITION BY title
            ORDER BY trending_date
        ) AS previous_views

    FROM vw_clean_youtube_data
)

SELECT
    title,
    trending_date,
    previous_views,
    views,

    (previous_views - views) AS drop_amount

FROM trend_cte

WHERE previous_views IS NOT NULL
AND views < previous_views

ORDER BY drop_amount DESC;

-- Q34 Monthly Growth Intelligence

WITH growth_cte AS (

    SELECT

        MONTH(
            STR_TO_DATE(
                trending_date,
                '%y.%d.%m'
            )
        ) AS month_no,

        SUM(views) AS monthly_views,

        LAG(SUM(views))
        OVER(
            ORDER BY MONTH(
                STR_TO_DATE(
                    trending_date,
                    '%y.%d.%m'
                )
            )
        ) AS previous_month_views

    FROM vw_clean_youtube_data

    GROUP BY MONTH(
        STR_TO_DATE(
            trending_date,
            '%y.%d.%m'
        )
    )
)

SELECT *,
ROUND(
    ((monthly_views - previous_month_views)
    / previous_month_views) * 100,
    2
) AS growth_rate

FROM growth_cte;

-- Q35 Executive Dashboard VIEW

CREATE VIEW vw_executive_dashboard AS

SELECT
    category_name,

    COUNT(DISTINCT video_id) AS total_videos,

    SUM(views) AS total_views,

    AVG(likes) AS avg_likes,

    AVG(comments) AS avg_comments

FROM vw_clean_youtube_data

GROUP BY category_name;

SELECT * FROM yt_analytics_dw.vw_executive_dashboard;

-- Q36 Funnel Analytics

SELECT
    SUM(views) AS total_views,
    SUM(likes) AS total_likes,
    SUM(comments) AS total_comments

FROM vw_clean_youtube_data;

-- Q37 Executive Pivot Report

SELECT
    category_name,

    SUM(
        CASE
            WHEN MONTH(
                STR_TO_DATE(
                    trending_date,
                    '%y.%d.%m'
                )
            ) = 1
            THEN views
            ELSE 0
        END
    ) AS Jan_Views,

    SUM(
        CASE
            WHEN MONTH(
                STR_TO_DATE(
                    trending_date,
                    '%y.%d.%m'
                )
            ) = 2
            THEN views
            ELSE 0
        END
    ) AS Feb_Views,

    SUM(views) AS Total_Views

FROM vw_clean_youtube_data

GROUP BY category_name;

